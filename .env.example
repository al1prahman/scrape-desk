# Copy jadi .env.local lalu isi dengan nilai asli

# Supabase API keys, format baru sb_publishable dan sb_secret
# Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-side only, jangan pernah kasih prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_xxx

# Project Settings > Database > Connection string > Session pooler
# Direct connection IPv6-only buat project baru, lokal wajib pakai pooler
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM buat mode AI Extract, OpenAI-compatible
# Default colok ke 9Router lokal, bisa diganti provider mana pun
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=not-needed
LLM_MODEL=gpt-4o-mini

# Kuota run harian per user, default 50 kalau nggak diisi
DAILY_RUN_QUOTA=50
